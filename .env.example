# Copy to .env for local development. Never commit .env. On Cloudflare Pages, set these in Settings → Variables and
# Secrets, for Production AND Preview (RESEND_API_KEY and NUXT_TURNSTILE_SECRET_KEY as type Secret).

# --- Contact form email (Resend) — server only ---
# API key from https://resend.com/api-keys. Required in production. In `nuxt dev` without it, the email is printed
# to the terminal instead of being sent.
RESEND_API_KEY=
# Recipient of the enquiries. Default: info@moesaltd.com
CONTACT_TO=info@moesaltd.com
# Sender: an address on a domain verified in Resend, e.g. "MOESA Website <website@moesaltd.com>". Required in
# production. The visitor's email is only ever used as Reply-To, never as From.
CONTACT_FROM=

# --- Spam protection (Cloudflare Turnstile) ---
# Secret key — server only.
NUXT_TURNSTILE_SECRET_KEY=
# Site key — public. The contact pages are prerendered, so set it at BUILD time. When it is empty the widget
# is not rendered (the Turnstile script is not loaded at all) and the form still renders and validates; the server then
# rejects the submission (no token) unless the dev bypass below is on.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local development only: "true" skips the Turnstile check, but ONLY inside `nuxt dev` (import.meta.dev).
# A production build ignores it, so it can never switch off spam protection in production. Leave unset on Cloudflare Pages.
CONTACT_DEV_BYPASS_TURNSTILE=

# --- Site ---
# Read at build time AND at runtime: set once in the Pages project variables (they reach the build and the function).
# "false" hides the Turkish site (no TR routes prerendered, no TR switcher entry, no TR sitemap URLs/alternates;
# at runtime every /tr path answers 404 and contact redirects go to EN).
NUXT_PUBLIC_ENABLE_TR=
# "false" hides the German site, the same way.
NUXT_PUBLIC_ENABLE_DE=
# "false" hides the Bulgarian site, the same way (wrangler.toml: off in production, on in preview deployments).
NUXT_PUBLIC_ENABLE_BG=
# Analytics id. Leave EMPTY in v1: no analytics scripts and no non-essential cookies. Setting it only shows the
# cookie consent banner (until a choice is stored in the strictly necessary `moesa_consent` cookie); an analytics
# loader must still check consent. Pages gives it to the build too, which matters because some pages are prerendered.
NUXT_PUBLIC_ANALYTICS_ID=

# Build + runtime. "true" shows the legal pages' review notes (Draft status chip, OPEN notes) for the lawyer and the
# owner. Pages PREVIEW environment only (wrangler.toml [env.preview.vars]); leave unset in production and locally.
NUXT_PUBLIC_LEGAL_REVIEW_NOTES=

# Build-time. "false" makes the deployment non-indexable (robots.txt "Disallow: /", noindex). Pages PREVIEW environment only.
NUXT_SITE_INDEXABLE=

# --- Rate limit client IP ---
# On Cloudflare (the request runs in the Pages Function) the contact route keys its rate limit on CF-Connecting-IP
# (set and overwritten by Cloudflare's edge); anywhere else that header is ignored and the socket address is used.
# "true" also trusts the first X-Forwarded-For entry — only behind a proxy that overwrites it. Leave unset on Pages.
CONTACT_TRUST_XFF=

# --- Cloudflare Pages build only ---
# Node for the Pages build (Nuxt 4.6 needs 22.21 or newer; set an exact version if "22" resolves to an older one).
# NODE_VERSION=22
